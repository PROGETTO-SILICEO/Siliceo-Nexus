# Configurazione locale sicura. Per esporre Nexus nella LAN/Tailscale, imposta
# un indirizzo non-loopback e configura entrambi i token qui sotto.
NEXUS_ADDR=127.0.0.1:8082
DATABASE_URL=sqlite://data/nexus.db
RUST_LOG=siliceo_nexus=info

# Richiesti quando NEXUS_ADDR non e' loopback. NEXUS_API_TOKEN protegge gli
# endpoint OpenAI/Anthropic; NEXUS_ADMIN_TOKEN protegge il dashboard e la gestione.
NEXUS_API_TOKEN=
NEXUS_ADMIN_TOKEN=

# Host consentiti per endpoint privati HTTP/HTTPS, separati da virgole.
# Esempio: NEXUS_TRUSTED_ENDPOINT_HOSTS=node-gpu.home,100.98.20.76
NEXUS_TRUSTED_ENDPOINT_HOSTS=

# Limite globale delle richieste di inferenza per finestra mobile di 60 secondi.
NEXUS_MAX_REQUESTS_PER_MINUTE=120

# Chiavi API Provider (opzionali per il seeding iniziale)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
